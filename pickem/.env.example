# Supabase project: nfl-pickem
NEXT_PUBLIC_SUPABASE_URL=https://ssvogyvnnwytiysgcmdw.supabase.co

# Dashboard -> Project Settings -> API -> service_role key.
# Server-only. Never expose this to the browser; RLS is on with no policies,
# so this key is what lets the app read and write at all.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, writing picks or results requires this passcode.
# Leave unset for an open board.
PICKEM_PASSCODE=
