# Supabase project: nfl-pickem
NEXT_PUBLIC_SUPABASE_URL=https://ssvogyvnnwytiysgcmdw.supabase.co

# One of these two is required. Both are server-only -- note there is no
# NEXT_PUBLIC_ prefix on either, so neither is bundled into the browser.
#
# Preferred: the service_role key (Project Settings -> API). It bypasses RLS,
# so no policy grants anyone else access.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback: the publishable key. Maps to the `anon` role, which carries RLS
# policies allowing board access. Weaker -- anyone holding this key could edit
# pick data directly, bypassing PICKEM_PASSCODE -- but it needs no secret.
# The app prefers the service-role key whenever both are set.
SUPABASE_PUBLISHABLE_KEY=

# Optional. When set, writing picks or results requires this passcode.
# Leave unset for an open board.
PICKEM_PASSCODE=
